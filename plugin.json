    {
      "name": "location",
      "type": "location_search",
      "label": "Place",
      "default": "",
      "help": "Observations within the circle below of this place. Falls back to the app-level location. Leave it empty, with an iNaturalist username below, to show that person's observations from anywhere."
    },
    {
      "name": "radius_km",
      "type": "select",
      "label": "Within",
      "default": "10",
      "choices": [
        {
          "value": "2",
