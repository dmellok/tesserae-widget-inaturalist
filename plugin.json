{
  "tesserae_compat": "1.x",
  "name": "Nature Nearby (iNaturalist)",
  "version": "0.1.0",
  "kind": "widget",
  "description": "What people have found near a place lately on iNaturalist, or your own observations: birds, mammals, insects, plants, fungi and more, as granular as you like. A page of the species together (cut out and packed as a specimen sheet, from AI paintings in 46 styles or your own prompt), a gallery, the latest find, a field log, a full-bleed picture and a tally by kind. Photos are the observers' own, credited.",
  "icon": "ph-leaf",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "requires": [
    "network:api.inaturalist.org",
    "network:inaturalist-open-data.s3.amazonaws.com",
    "network:static.inaturalist.org",
    "network:fal.run",
    "network:v3.fal.media",
    "network:v3b.fal.media",
    "network:fal.media"
  ],
  "settings": [
    {
      "name": "fal_api_key",
      "type": "string",
      "label": "fal.ai API key (AI paintings, experimental)",
      "secret": true,
      "default": "",
      "help": "Only needed for the AI painting picture option. Each species is painted once, from the observation's own openly licensed photo, in the background (it shows on a later refresh), and kept, at about US$0.04 a species up to the daily limit below. Manage the paintings on this widget's page under Widgets. Get a key at https://fal.ai/dashboard/keys; it is only sent to fal.run."
    },
    {
      "name": "gen_daily_cap",
      "type": "select",
      "label": "AI paintings per day",
      "default": "12",
      "help": "The most new AI paintings made in a day, at about US$0.04 each. Paintings are kept, so a place's species only cost once; raise this to fill a specimen sheet faster.",
      "choices": [
        {
          "value": "6",
          "label": "6 (about US$0.24)"
        },
        {
          "value": "12",
          "label": "12 (about US$0.48)"
        },
        {
          "value": "24",
          "label": "24 (about US$0.96)"
        },
        {
          "value": "48",
          "label": "48 (about US$1.92)"
        },
        {
          "value": "96",
          "label": "96 (about US$3.84)"
        }
      ]
    }
  ],
